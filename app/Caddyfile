# DOMAIN = nom de domaine public (ex: lab.exemple.cd) -> certificat Let's Encrypt automatique.
# Sans DOMAIN : "localhost" avec un certificat local auto-signé (test uniquement).
{$DOMAIN:localhost} {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy web:3000
}
